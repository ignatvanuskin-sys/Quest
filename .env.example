# ============================================================
# NOX — переменные окружения
# Скопируйте в .env.local и заполните реальными значениями.
# ============================================================

# --- Telegram Bot API ---
# Уведомления о новых бронях владельцу.
# Токен бота получить у @BotFather, chat_id — у @userinfobot / getUpdates.
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789

# --- Публичный URL сайта ---
# Используется для OG/canonical/sitemap. На Vercel задайте свой домен.
NEXT_PUBLIC_SITE_URL=https://qwest-scary.vercel.app

# --- Аналитика (опционально) ---
# ID счётчика Яндекс.Метрики. Если не задан — аналитика не подключается.
# NEXT_PUBLIC_YM_ID=00000000
