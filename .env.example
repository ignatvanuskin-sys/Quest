# ============================================================
# NOX — переменные окружения
# Скопируйте в .env.local и заполните реальными значениями.
# ============================================================

# --- Telegram Bot API ---
# Уведомления о новых бронях владельцу.
# Токен бота получить у @BotFather, chat_id — у @userinfobot / getUpdates.
# Пока этих переменных нет, сайт работает в ДЕМО-РЕЖИМЕ: форма отправляется,
# валидация срабатывает, но заявка никуда не уходит, и гость видит честную
# пометку «Демо-режим: заявка не отправлена» (а не «Перезвоним»).
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789

# --- Демо-режим ---
# Необязательно. Управляет поведением, когда Telegram НЕ настроен:
#   не задано / любое значение кроме "false" → демо-режим (см. выше);
#   false                                    → приём заявок выключен, POST /api/book
#                                              отвечает 503 с телефоном для звонка.
# Для боевого сайта без Telegram ставьте false, чтобы форма не создавала
# видимость работающего приёма заявок.
# Значение читается на этапе сборки — после смены нужен повторный деплой.
# NEXT_PUBLIC_DEMO_MODE=false

# --- Публичный URL сайта ---
# Используется для OG/canonical/sitemap. На Vercel задайте свой домен.
NEXT_PUBLIC_SITE_URL=https://qwest-scary.vercel.app

# --- Аналитика (опционально) ---
# ID счётчика Яндекс.Метрики. Если не задан — аналитика не подключается.
# NEXT_PUBLIC_YM_ID=00000000
